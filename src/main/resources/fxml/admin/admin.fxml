<?import com.loja.ui.components.Card?>
<?import com.loja.ui.components.FormField?>
<?import com.loja.ui.components.PillNav?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="1050.0" spacing="20.0" style="-fx-background-color: #f4f6f8;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.loja.ui.controllers.MenuAdminController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>

      <HBox alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 8, 0, 0, 2);">
         <padding>
            <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0" HBox.hgrow="ALWAYS">
               <children>
                  <StackPane prefHeight="48.0" prefWidth="48.0" style="-fx-background-color: #e0e7ff; -fx-background-radius: 10;">
                     <children>
                        <Label text="🛠" textFill="#4f46e5">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                     </children>
                  </StackPane>
                  <VBox alignment="CENTER_LEFT" spacing="2.0">
                     <children>
                        <Label fx:id="lblBoasVindas" text="PAINEL ADMINISTRATIVO" textFill="#1e293b">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <Label text="GERENCIAMENTO COMPLETO DE RECURSOS DA LOJA" textFill="#64748b">
                           <font>
                              <Font name="System Bold" size="10.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <PillNav fx:id="navModulos" />
         </children>
      </HBox>

      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
         <content>
            <StackPane>
               <children>

                  <VBox fx:id="paneUsuarios" spacing="20.0">
                     <children>
                        <Card>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label fx:id="lblFormUsuario" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Cadastrar Novo Usuário" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <HBox fx:id="badgeUsuario" />
                                 </children>
                              </HBox>
                              <FlowPane hgap="16.0" vgap="14.0">
                                 <children>
                                    <FormField fx:id="fUsuarioId" labelText="ID" prefWidth="210.0">
                                       <TextField promptText="Gerado automaticamente" />
                                    </FormField>
                                    <VBox prefWidth="210.0" spacing="6.0">
                                       <children>
                                          <Label style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #4b5563;" text="TIPO / PERFIL" />
                                          <ComboBox fx:id="cbUsuarioPerfil" maxWidth="Infinity" onAction="#alterarPerfil" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-font-size: 13px;" />
                                       </children>
                                    </VBox>
                                    <FormField fx:id="fUsuarioNome" labelText="Nome" prefWidth="210.0">
                                       <TextField promptText="Nome completo" />
                                    </FormField>
                                    <FormField fx:id="fUsuarioLogin" labelText="Login" prefWidth="210.0">
                                       <TextField promptText="Ex: maria.oliveira" />
                                    </FormField>
                                    <FormField fx:id="fUsuarioSenha" labelText="Senha" prefWidth="210.0">
                                       <PasswordField promptText="********" />
                                    </FormField>
                                    <FormField fx:id="fUsuarioCargo" labelText="Cargo" prefWidth="210.0">
                                       <TextField promptText="Ex: Atendente" />
                                    </FormField>
                                 </children>
                              </FlowPane>
                              <HBox maxWidth="440.0" spacing="8.0">
                                 <children>
                                    <Button fx:id="btnSalvarUsuario" maxWidth="Infinity" onAction="#salvarUsuario" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnCancelarUsuario" onAction="#cancelarUsuario" text="Cancelar" />
                                 </children>
                              </HBox>
                              <VBox fx:id="feedbackUsuario" />
                           </children>
                        </Card>

                        <Card>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                              <children>
                                 <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Listar Usuários" />
                                 <Region HBox.hgrow="ALWAYS" />
                                 <TextField fx:id="txtPesquisaUsuarios" prefWidth="320.0" promptText="🔍 Pesquisar por ID, nome, login, perfil ou cargo..." style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 8px 12px; -fx-font-size: 13px;" />
                              </children>
                              </HBox>
                              <TableView fx:id="tblUsuarios" prefHeight="280.0">
                                 <columns>
                                    <TableColumn fx:id="colUsuarioId" prefWidth="80.0" style="-fx-font-family: monospace;" text="ID" />
                                    <TableColumn fx:id="colUsuarioPerfil" prefWidth="130.0" text="Perfil" />
                                    <TableColumn fx:id="colUsuarioNome" prefWidth="170.0" text="Nome" />
                                    <TableColumn fx:id="colUsuarioLogin" prefWidth="190.0" text="Login" />
                                    <TableColumn fx:id="colUsuarioCargo" prefWidth="110.0" text="Cargo" />
                                    <TableColumn fx:id="colUsuarioSituacao" prefWidth="100.0" text="Situação" />
                                    <TableColumn fx:id="colUsuarioAcoes" prefWidth="260.0" sortable="false" text="Ações" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <Pagination fx:id="paginacaoUsuarios" maxPageIndicatorCount="5" pageCount="1" prefHeight="45.0" />
                           </children>
                        </Card>
                     </children>
                  </VBox>

                  <VBox fx:id="paneItens" managed="false" spacing="20.0" visible="false">
                     <children>
                        <Card>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label fx:id="lblFormItem" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Cadastrar Novo Item" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <HBox fx:id="badgeItem" />
                                 </children>
                              </HBox>
                              <FlowPane hgap="16.0" vgap="14.0">
                                 <children>
                                    <FormField fx:id="fItemId" labelText="ID" prefWidth="210.0">
                                       <TextField promptText="Ex: I01" />
                                    </FormField>
                                    <FormField fx:id="fItemNome" labelText="Nome" prefWidth="210.0">
                                       <TextField promptText="Nome do item" />
                                    </FormField>
                                    <VBox prefWidth="210.0" spacing="6.0">
                                       <children>
                                          <Label style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #4b5563;" text="CATEGORIA" />
                                          <ComboBox fx:id="cbItemCategoria" maxWidth="Infinity" promptText="Selecione" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-font-size: 13px;" />
                                       </children>
                                    </VBox>
                                    <VBox prefWidth="210.0" spacing="6.0">
                                       <children>
                                          <Label style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #4b5563;" text="FORNECEDOR" />
                                          <ComboBox fx:id="cbItemFornecedor" maxWidth="Infinity" promptText="Selecione" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-font-size: 13px;" />
                                       </children>
                                    </VBox>
                                    <FormField fx:id="fItemTaxa" labelText="Taxa Diária (R$)" prefWidth="210.0">
                                       <TextField promptText="0.00" />
                                    </FormField>
                                    <FormField fx:id="fItemReposicao" labelText="Valor Reposição (R$)" prefWidth="210.0">
                                       <TextField promptText="0.00" />
                                    </FormField>
                                 </children>
                              </FlowPane>
                              <HBox maxWidth="440.0" spacing="8.0">
                                 <children>
                                    <Button fx:id="btnSalvarItem" maxWidth="Infinity" onAction="#salvarItem" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnCancelarItem" onAction="#cancelarItem" text="Cancelar" />
                                 </children>
                              </HBox>
                              <VBox fx:id="feedbackItem" />
                           </children>
                        </Card>

                        <Card>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Listar Itens" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button onAction="#relatorioDisponiveisPorCategoria" style="-fx-background-color: #eef2ff; -fx-text-fill: #4f46e5; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;" text="Itens Disponíveis por categoria" />
                                    <TextField fx:id="txtPesquisaItens" prefWidth="320.0" promptText="🔍 Pesquisar por ID, nome, status, categoria ou fornecedor..." style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 8px 12px; -fx-font-size: 13px;" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tblItens" prefHeight="280.0">
                                 <columns>
                                    <TableColumn fx:id="colItemId" prefWidth="80.0" style="-fx-font-family: monospace;" text="ID" />
                                    <TableColumn fx:id="colItemNome" prefWidth="170.0" text="Nome" />
                                    <TableColumn fx:id="colItemStatus" prefWidth="120.0" text="Status" />
                                    <TableColumn fx:id="colItemCategoria" prefWidth="110.0" text="Categoria" />
                                    <TableColumn fx:id="colItemFornecedor" prefWidth="130.0" text="Fornecedor" />
                                    <TableColumn fx:id="colItemTaxa" prefWidth="100.0" text="Taxa Diária" />
                                    <TableColumn fx:id="colItemAcoes" prefWidth="170.0" sortable="false" text="Ações" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <Pagination fx:id="paginacaoItens" maxPageIndicatorCount="5" pageCount="1" prefHeight="45.0" />
                           </children>
                        </Card>
                     </children>
                  </VBox>

                  <VBox fx:id="paneCategorias" managed="false" spacing="20.0" visible="false">
                     <children>
                        <Card>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label fx:id="lblFormCategoria" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Cadastrar Nova Categoria" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <HBox fx:id="badgeCategoria" />
                                 </children>
                              </HBox>
                              <FlowPane hgap="16.0" vgap="14.0">
                                 <children>
                                    <FormField fx:id="fCategoriaId" labelText="ID" prefWidth="210.0">
                                       <TextField promptText="Ex: CAT01" />
                                    </FormField>
                                    <FormField fx:id="fCategoriaNome" labelText="Nome" prefWidth="210.0">
                                       <TextField promptText="Nome da categoria" />
                                    </FormField>
                                 </children>
                              </FlowPane>
                              <HBox maxWidth="440.0" spacing="8.0">
                                 <children>
                                    <Button fx:id="btnSalvarCategoria" maxWidth="Infinity" onAction="#salvarCategoria" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnCancelarCategoria" onAction="#cancelarCategoria" text="Cancelar" />
                                 </children>
                              </HBox>
                              <VBox fx:id="feedbackCategoria" />
                           </children>
                        </Card>

                        <Card>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Listar Categorias" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="txtPesquisaCategorias" prefWidth="320.0" promptText="🔍 Pesquisar por ID ou nome..." style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 8px 12px; -fx-font-size: 13px;" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tblCategorias" prefHeight="280.0">
                                 <columns>
                                    <TableColumn fx:id="colCategoriaId" prefWidth="100.0" style="-fx-font-family: monospace;" text="ID" />
                                    <TableColumn fx:id="colCategoriaNome" prefWidth="300.0" text="Nome" />
                                    <TableColumn fx:id="colCategoriaAcoes" prefWidth="170.0" sortable="false" text="Ações" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <Pagination fx:id="paginacaoCategorias" maxPageIndicatorCount="5" pageCount="1" prefHeight="45.0" />
                           </children>
                        </Card>
                     </children>
                  </VBox>

                  <VBox fx:id="paneFornecedores" managed="false" spacing="20.0" visible="false">
                     <children>
                        <Card>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label fx:id="lblFormFornecedor" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Cadastrar Novo Fornecedor" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <HBox fx:id="badgeFornecedor" />
                                 </children>
                              </HBox>
                              <FlowPane hgap="16.0" vgap="14.0">
                                 <children>
                                    <FormField fx:id="fFornecedorId" labelText="ID" prefWidth="210.0">
                                       <TextField promptText="Ex: F01" />
                                    </FormField>
                                    <FormField fx:id="fFornecedorNome" labelText="Nome" prefWidth="210.0">
                                       <TextField promptText="Nome da empresa" />
                                    </FormField>
                                    <FormField fx:id="fFornecedorCnpj" labelText="CNPJ" prefWidth="210.0">
                                       <TextField promptText="00.000.000/0001-00" />
                                    </FormField>
                                    <FormField fx:id="fFornecedorTelefone" labelText="Telefone" prefWidth="210.0">
                                       <TextField promptText="(00) 00000-0000" />
                                    </FormField>
                                 </children>
                              </FlowPane>
                              <HBox maxWidth="440.0" spacing="8.0">
                                 <children>
                                    <Button fx:id="btnSalvarFornecedor" maxWidth="Infinity" onAction="#salvarFornecedor" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnCancelarFornecedor" onAction="#cancelarFornecedor" text="Cancelar" />
                                 </children>
                              </HBox>
                              <VBox fx:id="feedbackFornecedor" />
                           </children>
                        </Card>

                        <Card>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Listar Fornecedores" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="txtPesquisaFornecedores" prefWidth="320.0" promptText="🔍 Pesquisar por ID, nome, CNPJ ou telefone..." style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 8px 12px; -fx-font-size: 13px;" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tblFornecedores" prefHeight="280.0">
                                 <columns>
                                    <TableColumn fx:id="colFornecedorId" prefWidth="80.0" style="-fx-font-family: monospace;" text="ID" />
                                    <TableColumn fx:id="colFornecedorNome" prefWidth="200.0" text="Nome" />
                                    <TableColumn fx:id="colFornecedorCnpj" prefWidth="160.0" text="CNPJ" />
                                    <TableColumn fx:id="colFornecedorTelefone" prefWidth="140.0" text="Telefone" />
                                    <TableColumn fx:id="colFornecedorAcoes" prefWidth="170.0" sortable="false" text="Ações" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <Pagination fx:id="paginacaoFornecedores" maxPageIndicatorCount="5" pageCount="1" prefHeight="45.0" />
                           </children>
                        </Card>
                     </children>
                  </VBox>

                  <VBox fx:id="paneRelatorios" managed="false" spacing="20.0" visible="false">
                     <children>
                        <VBox fx:id="feedbackRelatorios" />

                        <Card>
                           <children>
                              <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Faturamento por Período" />
                              <Label style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" text="Soma dos aluguéis encerrados e das multas quitadas no período." />
                              <HBox alignment="BOTTOM_LEFT" spacing="16.0">
                                 <children>
                                    <VBox spacing="6.0">
                                       <children>
                                          <Label style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #4b5563;" text="DATA INICIAL" />
                                          <DatePicker fx:id="dpFaturamentoInicio" prefWidth="180.0" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="6.0">
                                       <children>
                                          <Label style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #4b5563;" text="DATA FINAL" />
                                          <DatePicker fx:id="dpFaturamentoFim" prefWidth="180.0" />
                                       </children>
                                    </VBox>
                                    <Button onAction="#gerarFaturamento" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 24; -fx-cursor: hand;" text="Gerar Relatório" />
                                    <Button onAction="#exportarFaturamento" style="-fx-background-color: #eef2ff; -fx-text-fill: #4f46e5; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;" text="Salvar PDF / Imprimir" />
                                 </children>
                              </HBox>
                              <TextArea fx:id="txtFaturamento" editable="false" prefHeight="170.0" promptText="Escolha o período e clique em Gerar Relatório." style="-fx-font-family: monospace; -fx-font-size: 13px;" />
                           </children>
                        </Card>
                        <Card>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Itens Alugados no Momento" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblResumoAlugados" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" />
                                    <Button onAction="#carregarItensAlugados" style="-fx-background-color: #eef2ff; -fx-text-fill: #4f46e5; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;" text="Atualizar" />
                                    <Button onAction="#exportarItensAlugados" style="-fx-background-color: #eef2ff; -fx-text-fill: #4f46e5; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;" text="Salvar PDF / Imprimir" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tblAlugados" prefHeight="300.0">
                                 <columns>
                                    <TableColumn fx:id="colAlugadoContrato" prefWidth="90.0" text="Contrato" />
                                    <TableColumn fx:id="colAlugadoItem" prefWidth="160.0" text="Item" />
                                    <TableColumn fx:id="colAlugadoCliente" prefWidth="160.0" text="Cliente" />
                                    <TableColumn fx:id="colAlugadoRetirada" prefWidth="100.0" text="Retirada" />
                                    <TableColumn fx:id="colAlugadoPrevisao" prefWidth="110.0" text="Prev. Devolução" />
                                    <TableColumn fx:id="colAlugadoSituacao" prefWidth="110.0" text="Situação" />
                                    <TableColumn fx:id="colAlugadoAtraso" prefWidth="90.0" text="Dias Atraso" />
                                    <TableColumn fx:id="colAlugadoValor" prefWidth="100.0" text="Valor" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <Pagination fx:id="paginacaoAlugados" maxPageIndicatorCount="5" pageCount="1" prefHeight="45.0" />
                           </children>
                        </Card>
                     </children>
                  </VBox>

               </children>
            </StackPane>
         </content>
      </ScrollPane>

      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button onAction="#handleSair" style="-fx-background-color: #cbd5e1; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Sair / Desconectar" />
         </children>
      </HBox>
   </children>
</VBox>