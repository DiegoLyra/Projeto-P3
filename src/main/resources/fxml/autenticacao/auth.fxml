<?xml version="1.0" encoding="UTF-8"?>

<?import com.loja.ui.components.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fx:id="scroll" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.loja.ui.controllers.AuthController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
            style="-fx-background: #ffffff; -fx-background-color: #ffffff;">

    <HBox>
        <!-- Metade esquerda (50%): fixa, não muda ao alternar entre Entrar e Criar conta -->
        <VBox fx:id="brandPanel" alignment="CENTER" spacing="24"
              HBox.hgrow="ALWAYS" prefWidth="1" minWidth="320" maxWidth="Infinity"
              style="-fx-background-color: #ffffff;">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <VBox alignment="CENTER" spacing="0">
                <Label text="Encontre tudo que precisa em" wrapText="true" textAlignment="CENTER"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0b7fd6;"/>
                <Label text="um só lugar!" wrapText="true" textAlignment="CENTER"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
            </VBox>

            <Label text="Alugue o que precisar, quando precisar." wrapText="true" textAlignment="CENTER"
                   style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>

            <HBox alignment="CENTER" spacing="8">
                <Circle radius="4" fill="#0b7fd6"/>
                <Circle radius="4" fill="#d1d5db"/>
                <Circle radius="4" fill="#d1d5db"/>
            </HBox>
        </VBox>

        <!-- Metade direita (50%): fundo azul com o card -->
        <StackPane HBox.hgrow="ALWAYS" prefWidth="1" minWidth="0" maxWidth="Infinity"
                   style="-fx-background-color: #0b8ee8;">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <Card maxWidth="520" minWidth="260" maxHeight="-Infinity" spacing="18"
                  style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.18), 20, 0, 0, 6);">
                <padding>
                    <Insets top="36" right="36" bottom="36" left="36"/>
                </padding>

                <PageHeader fx:id="header" title="Aluga de um Tudo" subtitle="Acesse sua conta"/>
                <PillNav fx:id="nav"/>
                <VBox fx:id="bannerSlot"/>

                <!-- Os dois formulários ficam empilhados; o controller alterna entre eles com animação -->
                <StackPane fx:id="formsStack" alignment="TOP_CENTER">

                    <!-- LOGIN -->
                    <VBox fx:id="loginForm" spacing="18" maxWidth="Infinity">
                        <FormField labelText="E-mail / Login">
                            <TextField fx:id="txtLoginEmail" promptText="seu login ou e-mail" prefHeight="44"/>
                        </FormField>

                        <FormField labelText="Senha">
                            <PasswordField fx:id="txtLoginSenha" promptText="••••••" prefHeight="44" onAction="#entrar"/>
                        </FormField>

                        <Button text="Entrar" maxWidth="Infinity" prefHeight="46" onAction="#entrar"
                                style="-fx-background-color: #0b8ee8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-background-radius: 6px; -fx-cursor: hand;"/>
                    </VBox>

                    <!-- REGISTER -->
                    <VBox fx:id="registerForm" spacing="18" maxWidth="Infinity" visible="false" managed="false">
                        <FormField labelText="Nome completo">
                            <TextField fx:id="txtRegNome" prefHeight="44"/>
                        </FormField>

                        <FormField labelText="E-mail / Login">
                            <TextField fx:id="txtRegEmail" prefHeight="44"/>
                        </FormField>

                        <FormField labelText="Senha">
                            <PasswordField fx:id="txtRegSenha" prefHeight="44"/>
                        </FormField>

                        <FormField labelText="Confirmar senha">
                            <PasswordField fx:id="txtRegConfirmar" prefHeight="44" onAction="#cadastrar"/>
                        </FormField>

                        <Button text="Criar conta" maxWidth="Infinity" prefHeight="46" onAction="#cadastrar"
                                style="-fx-background-color: #0b8ee8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-background-radius: 6px; -fx-cursor: hand;"/>
                    </VBox>
                </StackPane>
            </Card>
        </StackPane>
    </HBox>
</ScrollPane>