<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.loja.ui.relatorios.PainelRelatorio?>

<BorderPane prefHeight="760.0" prefWidth="1100.0"
            style="-fx-background-color: #f8fafc;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.loja.ui.controllers.RelatorioFuncionarioController">

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="18.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
                    </padding>

                    <children>

                        <!-- Relatório de Faturamento -->
                        <VBox spacing="14.0"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e5e7eb; -fx-border-radius: 16; -fx-border-width: 1;">
                            <padding>
                                <Insets bottom="22.0" left="22.0" right="22.0" top="22.0"/>
                            </padding>

                            <children>
                                <Label text="Faturamento por Período"
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

                                <Label text="Selecione o período para consultar o faturamento da loja."
                                       wrapText="true"
                                       style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>

                                <Separator/>

                                <HBox alignment="BOTTOM_LEFT" spacing="12.0">
                                    <children>
                                        <VBox spacing="6.0">
                                            <children>
                                                <Label text="Data inicial" style="-fx-text-fill: #374151; -fx-font-weight: bold;"/>
                                                <DatePicker fx:id="dpFaturamentoInicio" prefWidth="180.0" promptText="Data inicial"/>
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0">
                                            <children>
                                                <Label text="Data final" style="-fx-text-fill: #374151; -fx-font-weight: bold;"/>
                                                <DatePicker fx:id="dpFaturamentoFim" prefWidth="180.0" promptText="Data final"/>
                                            </children>
                                        </VBox>

                                        <Button onAction="#gerarFaturamento"
                                                prefHeight="38.0"
                                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                                                text="Gerar Faturamento"/>
                                    </children>
                                </HBox>

                                <VBox fx:id="feedbackRelatorios" spacing="8.0"/>

                                <PainelRelatorio fx:id="painelFaturamento" />
                            </children>
                        </VBox>

                        <!-- Relatório de Itens Alugados -->
                        <VBox spacing="12.0"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e5e7eb; -fx-border-radius: 16; -fx-border-width: 1;"
                              VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="20.0" left="22.0" right="22.0" top="20.0"/>
                            </padding>

                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label text="Itens Alugados no Momento"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

                                        <Region HBox.hgrow="ALWAYS"/>

                                        <Label fx:id="lblTotalAlugados" text="Total: 0" style="-fx-text-fill: #475569; -fx-font-weight: bold;"/>
                                        <Label fx:id="lblTotalAtrasados" text="Em atraso: 0" style="-fx-text-fill: #b91c1c; -fx-font-weight: bold;"/>

                                        <Button onAction="#atualizarAlugados"
                                                prefHeight="38.0"
                                                style="-fx-background-color: #eef2ff; -fx-text-fill: #4338ca; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                                                text="Atualizar"/>

                                    </children>
                                </HBox>

                                <TableView fx:id="tabelaAlugados" prefHeight="270.0" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colContrato" prefWidth="90.0" text="Contrato"/>
                                        <TableColumn fx:id="colItem" prefWidth="150.0" text="Item"/>
                                        <TableColumn fx:id="colCliente" prefWidth="150.0" text="Cliente"/>
                                        <TableColumn fx:id="colRetirada" prefWidth="100.0" text="Retirada"/>
                                        <TableColumn fx:id="colDevolucao" prefWidth="120.0" text="Prev. Devolução"/>
                                        <TableColumn fx:id="colSituacao" prefWidth="90.0" text="Situação"/>
                                        <TableColumn fx:id="colDiasAtraso" prefWidth="90.0" text="Dias Atraso"/>
                                        <TableColumn fx:id="colValor" prefWidth="100.0" text="Valor"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="Nenhum item alugado no momento."/>
                                    </placeholder>
                                </TableView>
                                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                    <children>
                                        <Button onAction="#salvarAlugadosPDF"
                                                prefHeight="38.0"
                                                style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 18; -fx-cursor: hand;"
                                                text="Salvar PDF"/>
                                        <Button onAction="#imprimirAlugados"
                                                prefHeight="38.0"
                                                style="-fx-background-color: #eef2ff; -fx-text-fill: #4338ca; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 18; -fx-cursor: hand;"
                                                text="Imprimir"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>