<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1100.0" prefHeight="650.0"
            style="-fx-background-color: #f8fafc;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.loja.ui.controllers.MultasFuncionarioController">

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="24.0" right="24.0"
                        bottom="24.0" left="24.0"/>
            </padding>

            <children>
                <VBox spacing="18.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-border-color: #e5e7eb;
                             -fx-border-radius: 16;
                             -fx-border-width: 1;">
                    <padding>
                        <Insets top="26.0" right="26.0"
                                bottom="26.0" left="26.0"/>
                    </padding>

                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label text="Multas Pendentes"
                                               style="-fx-font-size: 22px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #1f2937;"/>
                                        <Label text="Consulte as multas dos clientes e registre a quitação."
                                               wrapText="true"
                                               style="-fx-font-size: 13px;
                                                      -fx-text-fill: #6b7280;"/>
                                    </children>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button text="Atualizar Lista"
                                        onAction="#atualizarMultas"
                                        prefHeight="38.0"
                                        style="-fx-background-color: #2563eb;
                                               -fx-text-fill: white;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 8;
                                               -fx-cursor: hand;"/>
                            </children>
                        </HBox>

                        <Separator/>

                        <HBox spacing="20.0" alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="lblTotalMultas"
                                       text="Multas pendentes: 0"
                                       style="-fx-text-fill: #475569;
                                              -fx-font-weight: bold;"/>

                                <Label fx:id="lblValorTotal"
                                       text="Valor total: R$ 0,00"
                                       style="-fx-text-fill: #b91c1c;
                                              -fx-font-weight: bold;"/>
                            </children>
                        </HBox>

                        <Label fx:id="lblMensagem"
                               wrapText="true"
                               style="-fx-font-size: 13px;
                                      -fx-font-weight: bold;"/>

                        <TableView fx:id="tabelaMultas"
                                   prefHeight="380.0"
                                   VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <columns>
                                <TableColumn fx:id="colId"
                                             text="Multa"
                                             prefWidth="90.0"/>
                                <TableColumn fx:id="colContrato"
                                             text="Contrato"
                                             prefWidth="100.0"/>
                                <TableColumn fx:id="colCliente"
                                             text="Cliente"
                                             prefWidth="180.0"/>
                                <TableColumn fx:id="colMotivo"
                                             text="Motivo"
                                             prefWidth="180.0"/>
                                <TableColumn fx:id="colValor"
                                             text="Valor"
                                             prefWidth="110.0"/>
                                <TableColumn fx:id="colSituacao"
                                             text="Situação"
                                             prefWidth="110.0"/>
                                <TableColumn fx:id="colAcao"
                                             text="Ação"
                                             prefWidth="110.0"/>
                            </columns>

                            <placeholder>
                                <Label text="Nenhuma multa pendente."/>
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>