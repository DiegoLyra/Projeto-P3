<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.loja.ui.controllers.MultaFuncionarioController"
            prefWidth="1200.0"
            prefHeight="750.0"
            style="-fx-background-color: #f5f6fa;">

    <top>
        <VBox spacing="8.0">
            <padding>
                <Insets top="30.0" right="35.0"
                        bottom="20.0" left="35.0"/>
            </padding>

            <Label text="Gerenciamento de Multas"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #202938;"/>

            <Label text="Consulte as multas dos clientes e realize a quitação."
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #667085;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="10.0" right="35.0"
                        bottom="25.0" left="35.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Label text="Multas registradas"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #202938;"/>
            </HBox>

            <TableView fx:id="tblMultas"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 8;">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <columns>
                    <TableColumn fx:id="colId"
                                 text="ID da Multa"
                                 prefWidth="130.0"/>

                    <TableColumn fx:id="colCliente"
                                 text="Cliente"
                                 prefWidth="230.0"/>

                    <TableColumn fx:id="colContrato"
                                 text="Contrato"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="colValor"
                                 text="Valor"
                                 prefWidth="130.0"/>

                    <TableColumn fx:id="colSituacao"
                                 text="Situação"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="colAcao"
                                 text="Ação"
                                 prefWidth="140.0"/>
                </columns>

                <placeholder>
                    <Label text="Nenhuma multa encontrada."
                           style="-fx-text-fill: #667085;
                                  -fx-font-size: 14px;"/>
                </placeholder>
            </TableView>

            <Label fx:id="mensagemLabel"
                   wrapText="true"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #475467;"/>

        </VBox>
    </center>

</BorderPane>