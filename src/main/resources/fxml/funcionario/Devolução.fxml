<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.loja.ui.controllers.FuncionarioController"
            prefWidth="1100.0"
            prefHeight="650.0"
            style="-fx-background-color: #f8fafc;">

    <center>
        <VBox alignment="TOP_CENTER" spacing="18.0">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
            </padding>

            <children>
                <VBox maxWidth="760.0" spacing="18.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-border-color: #e5e7eb;
                             -fx-border-radius: 16;
                             -fx-border-width: 1;">
                    <padding>
                        <Insets top="24.0" right="26.0" bottom="26.0" left="26.0"/>
                    </padding>

                    <children>
                        <VBox spacing="6.0">
                            <Label text="Processar Devolução"
                                   style="-fx-font-size: 19px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1f2937;"/>
                            <Label text="Informe o código do contrato para registrar a devolução do item alugado."
                                   wrapText="true"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #6b7280;"/>
                        </VBox>

                        <Separator/>

                        <VBox spacing="7.0">
                            <Label text="ID DO CONTRATO DE ALUGUEL"
                                   style="-fx-font-size: 11px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #4b5563;"/>
                            <TextField fx:id="txtContratoId"
                                       promptText="Digite o ID do contrato"
                                       prefHeight="40.0"
                                       maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="10.0"
                              style="-fx-background-color: #f9fafb;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #e5e7eb;
                                     -fx-border-radius: 12;">
                            <padding>
                                <Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/>
                            </padding>
                            <children>
                                <Label text="Antes de confirmar"
                                       style="-fx-font-size: 13px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #374151;"/>
                                <Label text="Confira se o ID pertence ao contrato correto. Se houver atraso, o sistema poderá aplicar a multa conforme as regras do projeto."
                                       wrapText="true"
                                       style="-fx-font-size: 12px;
                                              -fx-text-fill: #6b7280;"/>
                            </children>
                        </VBox>

                        <Label fx:id="mensagemLabel"
                               text=""
                               wrapText="true"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #b91c1c;"/>

                        <Button text="Confirmar Devolução"
                                onAction="#finalizarDevolucao"
                                maxWidth="Infinity"
                                prefHeight="44.0"
                                style="-fx-background-color: #2563eb;
                                       -fx-background-radius: 10;
                                       -fx-text-fill: white;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
