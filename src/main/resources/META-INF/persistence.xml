<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="loja" transaction-type="RESOURCE_LOCAL">

        <!-- Implementação da JPA usada no projeto -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entidades: adicione cada uma SÓ DEPOIS que ela tiver @Entity -->
        <class>com.loja.model.Categoria</class>
        <!--SO TIRA A ANOTAÇÃO QUANDO ESTIVER PRONTO COM AS ANOTAÇÕES, CONSTRUCTOR E O DAO-->
        <!-- <class>com.loja.model.Fornecedor</class> -->
        <!-- <class>com.loja.model.Item</class> -->
        <!-- <class>com.loja.model.Usuario</class> -->
        <!-- <class>com.loja.model.Cliente</class> -->
        <!-- <class>com.loja.model.Funcionario</class> -->
        <!-- <class>com.loja.model.Administrador</class> -->
        <!-- <class>com.loja.model.ContratoAluguel</class> -->
        <!-- <class>com.loja.model.Multa</class> -->

        <!-- Só usa as classes listadas acima -->
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Conexão com o SQLite (o arquivo .db é criado na pasta onde o app roda) -->
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:dados/loja.db?foreign_keys=true"/>

            <!-- SQLite não vem no hibernate-core: o dialeto é do hibernate-community-dialects -->
            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>

            <!-- Cria/atualiza as tabelas a partir das entidades, sem apagar dados -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Mostra no terminal o SQL executado -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

        </properties>
    </persistence-unit>
</persistence>