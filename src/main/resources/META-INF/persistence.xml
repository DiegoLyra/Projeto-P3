
<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="loja" transaction-type="RESOURCE_LOCAL">

        <!-- Implementação da JPA usada no projeto -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entidades registradas na unidade de persistência -->
        <class>com.loja.model.Categoria</class>
        <class>com.loja.model.Usuario</class>
        <class>com.loja.model.Funcionario</class>
        <class>com.loja.model.Cliente</class>
        <class>com.loja.model.Administrador</class>
        <class>com.loja.model.Item</class>
        <class>com.loja.model.ContratoAluguel</class>

        <!-- Só utiliza as classes listadas acima -->
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Conexão com o SQLite -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.sqlite.JDBC"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:sqlite:loja_aluga_tudo.db?foreign_keys=true"/>

            <!-- Dialeto SQLite -->
            <property name="hibernate.dialect"
                      value="org.hibernate.community.dialect.SQLiteDialect"/>

            <!-- Cria ou atualiza as tabelas sem apagar dados -->
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <!-- Exibe o SQL executado no terminal -->
            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>
        </properties>

    </persistence-unit>
</persistence>
